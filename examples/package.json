{
  "name": "dialai-examples",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "TICK_INTERVAL_MS=200 tsx watch --env-file=../.env server/index.ts",
    "dev:ui": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:ui\"",
    "build": "vite build",
    "start": "tsx --env-file=../.env server/index.ts"
  },
  "dependencies": {
    "dialai": "file:..",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.2",
    "vite": "^6.0.0"
  }
}
